<Patch>
    <!-- Add new player mechanitor def -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs</xpath>
        <value>
            <PawnKindDef ParentName="MechanitorBase">
                <defName>BL_Mechanitor</defName>
            </PawnKindDef>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>//ScenarioDef[defName="Mechanitor"]/scenario/parts/li[def="ConfigurePawnsKindDefs"]/kindCounts/li/kindDef[text()="Mechanitor"]/text() | //ScenarioDef[defName="Mechanitor"]/scenario/parts/li[def="ConfigurePawnsKindDefs"]/leftBehindPawnKind/text()</xpath>
        <value>BL_Mechanitor</value>
    </Operation>
    <!-- Better mechanitor -->
    <Operation Class="XmlExtensions.OptionalPatch">
        <modId>boomer.Rebalance</modId>
        <key>betterMechanitor</key>
        <defaultValue>false</defaultValue>
        <caseTrue>
            <!-- Prepatch SMG -->
            <Operation Class="PatchOperationConditional">
                <xpath>//ThingDef[defName="Gun_HeavySMG"]/weaponTags/li[text()="BL_HeavySMG"]</xpath>
                <nomatch Class="PatchOperationAdd">
                    <xpath>//ThingDef[defName="Gun_HeavySMG"]/weaponTags</xpath>
                    <value>
                        <li>BL_HeavySMG</li>
                    </value>
                </nomatch>
            </Operation>
            <!-- Skills, traits, weapon, and work -->
            <Operation Class="PatchOperationAdd">
                <xpath>//PawnKindDef[defName="BL_Mechanitor"]</xpath>
                <value>
                    <weaponTags Inherit="False">
                        <li>BL_HeavySMG</li>
                    </weaponTags>
                    <weaponMoney>355~900</weaponMoney>
                    <requiredWorkTags>
                        <li>Caring</li>
                        <li>Crafting</li>
                        <li>Intellectual</li>
                        <li>Violent</li>
                    </requiredWorkTags>
                    <disallowedTraits>
                        <li>BodyPurist</li>
                        <li>SlowLearner</li>
                        <li>Wimp</li>
                    </disallowedTraits>
                    <disallowedTraitsWithDegree>
                        <Immunity>-1</Immunity>
                        <Industriousness>-1</Industriousness>
                        <Industriousness>-2</Industriousness>
                        <PsychicSensitivity>-1</PsychicSensitivity>
                        <PsychicSensitivity>-2</PsychicSensitivity>
                    </disallowedTraitsWithDegree>
                    <skills>
                        <li>
                            <skill>Crafting</skill>
                            <range>6~10</range>
                        </li>
                        <li>
                            <skill>Intellectual</skill>
                            <range>6~10</range>
                        </li>
                    </skills>
                </value>
            </Operation>
        </caseTrue>
    </Operation>
    <!-- Gender -->
    <Operation Class="XmlExtensions.UseSetting">
        <modId>boomer.Rebalance</modId>
        <key>genderedMechanitor</key>
        <defaultValue>noGenderedMechanitor</defaultValue>
        <apply>
            <Operation Class="XmlExtensions.PatchByCase">
                <value>{genderedMechanitor}</value>
                <cases>
                    <li>
                        <value>maleGenderedMechanitor</value>
                        <apply>
                            <Operation Class="PatchOperationAdd">
                                <xpath>//PawnKindDef[defName="BL_Mechanitor"]</xpath>
                                <value>
                                    <fixedGender>Male</fixedGender>
                                </value>
                            </Operation>
                        </apply>
                    </li>
                    <li>
                        <value>femaleGenderedMechanitor</value>
                        <apply>
                            <Operation Class="PatchOperationAdd">
                                <xpath>//PawnKindDef[defName="BL_Mechanitor"]</xpath>
                                <value>
                                    <fixedGender>Female</fixedGender>
                                </value>
                            </Operation>
                        </apply>
                    </li>
                </cases>
            </Operation>
        </apply>
    </Operation>
    <!-- Age -->
    <Operation Class="XmlExtensions.UseSetting">
        <modId>boomer.Rebalance</modId>
        <key>minAgeMechanitor</key>
        <!-- Vanilla: undefined (defaults to 15) -->
        <defaultValue>15</defaultValue>
        <apply>
            <Operation Class="PatchOperationAdd">
                <xpath>//PawnKindDef[defName="BL_Mechanitor"]</xpath>
                <value>
                    <minGenerationAge>{minAgeMechanitor}</minGenerationAge>
                </value>
            </Operation>
        </apply>
    </Operation>
    <Operation Class="XmlExtensions.UseSetting">
        <modId>boomer.Rebalance</modId>
        <key>maxAgeMechanitor</key>
        <!-- Vanilla: undefined (I think it defaults to 80) -->
        <defaultValue>80</defaultValue>
        <apply>
            <Operation Class="PatchOperationAdd">
                <xpath>//PawnKindDef[defName="BL_Mechanitor"]</xpath>
                <value>
                    <maxGenerationAge>{maxAgeMechanitor}</maxGenerationAge>
                </value>
            </Operation>
        </apply>
    </Operation>
</Patch>